# Backend base URL (FastAPI / uvicorn)
VITE_API_URL=http://localhost:8000
# true = built-in mock data, no backend needed. false = call the real API.
VITE_USE_MOCK=true
# Route for GenerateTimetableRequest -> TimetableGenerationResponse.
# The backend does not expose this route yet; change it once it does.
VITE_GENERATE_PATH=/api/v1/timetable/generate
